ARKIV_RELAY_KEY=0x...
NEXT_PUBLIC_ARKIV_RPC=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Arkiv access key from hub.arkiv.network/api-keys (select Tiramisu).
# Server-side only — appended to the RPC path by /api/arkiv and the relay.
# Without it the app falls back to the anonymous (heavily limited) quota.
ARKIV_API_KEY=

# Public origin used for absolute OpenGraph URLs (set on deploy)
NEXT_PUBLIC_SITE_URL=https://your-deploy-url
